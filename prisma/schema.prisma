generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Booking {
  id         Int           @id @default(autoincrement())
  firstName  String
  lastName   String
  email      String
  phone      String?
  checkIn    DateTime
  checkOut   DateTime
  guests     Int
  createdAt  DateTime      @default(now())
  status     BookingStatus @default(PENDING)
  totalPrice Float
  unitId     Int
  unit       Unit          @relation(fields: [unitId], references: [id])
}

model BlockedDate {
  id        Int      @id @default(autoincrement())
  startDate DateTime
  endDate   DateTime
  notes     String?
  unitId    Int
  unit      Unit     @relation(fields: [unitId], references: [id])
}

model Unit {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  description  String
  maxGuests    Int
  blockedDates BlockedDate[]
  bookings     Booking[]
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}
